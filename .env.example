GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL=gemini-2.0-flash
PIPER_VOICE_MODEL=en_GB-alan-medium
WHISPER_MODEL=base
# "auto" detects CUDA via ctranslate2 and picks float16 on GPU / int8 on CPU.
# Set explicitly ("cuda"/"cpu", "float16"/"int8") to override auto-detection.
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
OPENROUTER_API_KEY=your_openrouter_api_key_here
# "openrouter/free" auto-selects from whatever free-tier models are currently
# available on OpenRouter. Avoid hardcoding a specific ":free" model slug here —
# OpenRouter deprecates/paywalls them without warning (see CHANGELOG.md).
OPENROUTER_MODEL=openrouter/free

